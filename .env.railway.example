# Railway Production Environment Template
PORT=5000
NODE_ENV=production

# Database Driver & Connection (automatically populated by Railway PostgreSQL plugin)
DB_DRIVER=postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_POOL_SIZE=10
PG_STATEMENT_TIMEOUT=15000
PG_IDLE_TX_TIMEOUT=10000
DATABASE_SSL=true

# Maintenance Circuit Breaker (toggle to true during scheduled maintenance)
MAINTENANCE_MODE=false

# Security & Credentials
JWT_SECRET=${{RAILWAY_SECRET_KEY}}
SUPEROWNER_USERNAME=shopos_superowner
SUPEROWNER_PASSWORD=${{SUPEROWNER_SECURE_PASSWORD}}
INITIAL_ADMIN_PASSWORD=${{ADMIN_SECURE_PASSWORD}}

# Web & Domain Routing
FRONTEND_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
SUPPORT_EMAIL=shopos.help@gmail.com
SUPPORT_INBOX=shopos.help@gmail.com

