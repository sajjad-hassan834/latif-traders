# Railway Production Environment Template
PORT=5000
NODE_ENV=production

# Database Driver & Configuration (SQLite for Release 1)
DB_PATH=/app/data/latif_traders.db
DATA_DIR=/app/data

# Reverse Proxy Trust Hops (1 for Railway direct; 2 for Vercel rewrite proxy to Railway)
TRUST_PROXY_HOPS=1

# Strict CORS Allowed Origins (only verified production frontend domains)
ALLOWED_ORIGINS=https://shoppyos.com,https://www.shoppyos.com,https://latiftraders.findcalculation.com,https://shopos.findcalculation.com,https://latif-traders.vercel.app
FRONTEND_URL=https://shoppyos.com,https://www.shoppyos.com,https://latiftraders.findcalculation.com,https://shopos.findcalculation.com,https://latif-traders.vercel.app

# Security & Secrets (Never use 'superowner' or 'shopos_superowner' for SUPEROWNER_USERNAME)
JWT_SECRET=${{RAILWAY_SECRET_KEY}}
SUPEROWNER_USERNAME=${{SUPEROWNER_CUSTOM_USERNAME}}
SUPEROWNER_PASSWORD=${{SUPEROWNER_SECURE_PASSWORD}}

# Support Mailbox
SUPPORT_EMAIL=shopos.help@gmail.com
SUPPORT_INBOX=shopos.help@gmail.com
