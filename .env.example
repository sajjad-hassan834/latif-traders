PORT=5000
NODE_ENV=production

# Database Configuration
# Set DB_DRIVER=postgres for PostgreSQL 16+ on Railway/Cloud, or DB_DRIVER=sqlite for SQLite
DB_DRIVER=postgres
DATABASE_URL=postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}?sslmode=require
DATABASE_POOL_SIZE=10
PG_STATEMENT_TIMEOUT=15000
PG_IDLE_TX_TIMEOUT=10000
DATABASE_SSL=true

# Maintenance Circuit Breaker (true blocks tenant traffic with HTTP 503 while /api/health and /api/superowner stay up)
MAINTENANCE_MODE=false

# Authentication & Security
# Minimum 32-character random string required in production (no default fallback)
JWT_SECRET=change_me_to_at_least_32_characters_random_secret_string

# Initial Setup Credentials (fresh database bootstrap)
SUPEROWNER_USERNAME=shopos_superowner
SUPEROWNER_PASSWORD=change_me_to_a_secure_superowner_password
INITIAL_ADMIN_PASSWORD=change_me_to_a_secure_admin_password

# Frontend URL (for CORS credentials validation)
FRONTEND_URL=https://app.shopos.com

# Public Support and Notifications
SUPPORT_EMAIL=shopos.help@gmail.com
SUPPORT_INBOX=shopos.help@gmail.com
