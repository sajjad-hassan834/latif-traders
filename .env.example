PORT=5000
# Minimum 32-character random string required in production
JWT_SECRET=change_me_to_at_least_32_characters_random_secret_string
NODE_ENV=production

# Initial Setup Credentials (fresh database bootstrap)
SUPEROWNER_USERNAME=shopos_superowner
SUPEROWNER_PASSWORD=change_me_to_a_secure_superowner_password
INITIAL_ADMIN_PASSWORD=change_me_to_a_secure_admin_password

# Frontend URL (for CORS credentials validation)
FRONTEND_URL=https://app.shopos.com

# Database Connection (when using PostgreSQL driver)
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional persistent storage path for Railway volumes (defaults to local ./data)
# DATA_DIR=/data

# Public Support and Notifications
SUPPORT_EMAIL=shopos.help@gmail.com
SUPPORT_INBOX=shopos.help@gmail.com
