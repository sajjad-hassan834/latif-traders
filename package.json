{
  "name": "latif-traders",
  "version": "1.0.0",
  "description": "Latif Traders - Frozen Food Business Management System",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "dev": "concurrently \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "test:pg:up": "docker compose -f docker-compose.test.yml up -d",
    "test:pg:down": "docker compose -f docker-compose.test.yml down",
    "test:pg": "node server/tests/stage_a_parity_and_concurrency.test.js",
    "test:stage-a2": "node server/tests/stage_a2_real_postgres.test.js",
    "test:parity": "node server/tests/stage_a2_api_parity.test.js",
    "schema:diff": "node server/scripts/schema_diff.js"
  },
  "keywords": [
    "pos",
    "inventory",
    "frozen-food",
    "erp",
    "management"
  ],
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "concurrently": "^9.1.2",
    "supertest": "^7.3.1"
  }
}
